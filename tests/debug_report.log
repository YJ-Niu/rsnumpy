                la = la * len(lb)
            elif sb == () and sa != () and len(lb) == 1:
                lb = lb * len(la)
            else:
                raise AssertionError(f"{err_msg}\n shape: {sa} != {sb}")
        # numpy 语义：无 shape 的标量操作数对数组广播。
