        >>> result = np.einsum('abc,bcd->ad', T1, T2)  # 在b和c维度上收缩
    
        # 6. 外积：'i,j->ij'
        >>> a = np.array([1, 2, 3])
        >>> b = np.array([4, 5])
        >>> np.einsum('i,j->ij', a, b)  # 等价于 np.outer(a, b)
        array([[ 4.,  5.],
               [ 8., 10.],
               [12., 15.]])
    
        # 7. 轨迹（trace）：'ii->'
        >>> np.einsum('ii->', M)  # 对角线元素求和
        15.0
    
        【常见模式速查】
        'ij,jk->ik'      # 矩阵乘法 (A @ B)
        'ij,ij->i'       # 逐元素乘积后按行求和
        'ij,kj->ik'      # 矩阵乘法（第二矩阵转置）
        'bij,bjk->bik'   # 批量矩阵乘法
        'abc,abc->a'     # 三维张量逐元素乘积后按bc维度求和
