        >>> np.linalg.dot(v1, v2)  # 1*4 + 2*5 + 3*6 = 32
        32.0
    
        >>> # 矩阵乘法
        >>> A = np.array([[1, 2], [3, 4]])
        >>> B = np.array([[5, 6], [7, 8]])
        >>> np.linalg.dot(A, B)  # 等价于 A @ B
        array([[19., 22.],
               [43., 50.]])
    
        >>> # 高维点积
        >>> T = np.random.rand(2, 3, 4)
