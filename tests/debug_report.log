        if low in ('bytes', 'bytes_', 'string', 'string_'):
            return _make_flexible('S', 0, bo)
        if low in ('void', 'void_'):
            return _make_flexible('V', 0, bo)
        # void<N>（DType.name 对 V 类型的输出，N=itemsize）
