                if i > size - 1:
                    i = size - 1
                if i < -size:
                    i = -size
            elif mode != 'wrap':
                if i < -size or i >= size:
                    raise IndexError(
                        f"index {i} is out of bounds for axis {ax} "
                        f"with size {size}")
            return i % size
    
