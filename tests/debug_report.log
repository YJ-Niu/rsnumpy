            # cast to float for comparison, as object does not support isnan
            a_cast = a.astype(float) if np.issubdtype(a.dtype, np.object_) else a
            expected = np.concatenate((expected[~np.isnan(a_cast)],
                                       expected[np.isnan(a_cast)]))
    
