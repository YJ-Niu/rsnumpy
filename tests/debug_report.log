        #                   always copies.
        b = a.astype('i4')
        assert_equal(a, b)
        assert_equal(b.dtype, np.dtype('i4'))
        assert_equal(a.strides, b.strides)
        b = a.T.astype('i4')
        assert_equal(a.T, b)
        assert_equal(b.dtype, np.dtype('i4'))
        assert_equal(a.T.strides, b.strides)
        b = a.astype('f4')
