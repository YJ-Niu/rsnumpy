        arr = np.zeros(1000, dtype=vals.dtype)
        zeros = arr.copy()
    
        if mode == "clip":
            # Special because 0 and -1 value are "reserved" for clip test
            indx = np.random.permutation(len(arr) - 2)[:-500] + 1
    
