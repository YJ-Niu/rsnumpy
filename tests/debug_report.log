            if sa is not None and len(lb) == 1:
                lb = lb * len(la)
            elif sb is not None and len(la) == 1:
                la = la * len(lb)
        if len(la) != len(lb):
            raise AssertionError(f"{err_msg}\n size: {len(la)} != {len(lb)}")
        if not _flat_values_equal(la, lb):
