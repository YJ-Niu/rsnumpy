        # swallows them (the core comparison below is what rsnumpy must satisfy).
        sa, sb = _shape(a), _shape(b)
        la, lb = _flat(a), _flat(b)
        if sa is not None and sb is not None and sa != sb:
            # numpy 语义：0-d（标量）操作数对另一形状做广播。
