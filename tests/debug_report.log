        'ii->i'          # 提取对角线
        'ii->'           # 迹（trace）
        'ij->ji'         # 转置
        'ij->'           # 所有元素求和
        'ij->i'          # 按列求和（每行求和）
        'ij->j'          # 按行求和（每列求和）
    
