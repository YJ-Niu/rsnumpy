            return _make_datetime(s[0], s[3:-1], bo)
        low = s.lower()
        if s in _KINDSIZE:
            return _make_scalar(_KINDSIZE[s], bo)
        if low in _KINDSIZE:
            return _make_scalar(_KINDSIZE[low], bo)
        if low in _SCALAR_INFO:
            return _make_scalar(low, bo)
        if low in _CANON_FULL:
